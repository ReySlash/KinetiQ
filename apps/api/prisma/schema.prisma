generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum BodyRegion {
  UPPER_BODY
  LOWER_BODY
  CORE
  FULL_BODY
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
  OTHER
}

enum ForceType {
  PUSH
  PULL
  STATIC
  OTHER
}

enum KineticChain {
  OPEN
  CLOSED
  MIXED
}

enum Laterality {
  UNILATERAL
  BILATERAL
  ALTERNATING
  OTHER
}

enum ContractionMode {
  DYNAMIC
  ISOMETRIC
  MIXED
}

enum BodyPosition {
  STANDING
  SITTING
  SUPINE
  PRONE
  KNEELING
  HINGED
  INVERTED
  OTHER
}

enum MuscleRole {
  PRIMARY
  SECONDARY
  STABILIZER
}

enum RoutineVisibility {
  PRIVATE
  GLOBAL
}

enum TrainingProgramVisibility {
  PRIVATE
  GLOBAL
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AdoptedTrainingProgramStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProgramWorkoutOccurrenceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum LoadUnit {
  KG
  LB
}

enum PlatformRole {
  USER
  ADMIN
}

model User {
  id                      String                   @id @db.Uuid
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  role                    PlatformRole             @default(USER)
  createdAt               DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                 @updatedAt @db.Timestamptz(3)
  sessions                Session[]
  accounts                Account[]
  routines                Routine[]
  trainingPrograms        TrainingProgram[]
  adoptedTrainingPrograms AdoptedTrainingProgram[]
  workoutSessions         WorkoutSession[]

  @@map("user")
}

model Session {
  id        String   @id @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

model MuscleGroup {
  id                  String     @id @db.Uuid
  name                String     @unique
  slug                String     @unique
  description         String?
  bodyRegion          BodyRegion
  thumbnailUrl        String?
  thumbnailStorageKey String?
  imageAltText        String?
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(3)
  muscles             Muscle[]
}

model Muscle {
  id                  String                     @id @db.Uuid
  name                String                     @unique
  slug                String                     @unique
  description         String
  bodyRegion          BodyRegion // (e.g., UPPER_BODY, LOWER_BODY)
  muscleGroupId       String?                    @db.Uuid
  parentId            String?                    @db.Uuid
  thumbnailUrl        String?
  thumbnailStorageKey String?
  imageAltText        String?
  isActive            Boolean                    @default(true)
  sortOrder           Int                        @default(0)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  muscleGroup         MuscleGroup?               @relation(fields: [muscleGroupId], references: [id], onDelete: Restrict)
  parent              Muscle?                    @relation("MuscleHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children            Muscle[]                   @relation("MuscleHierarchy")
  exerciseMuscles     ExerciseMuscle[] // Many-to-many relationship with exercises
  functionAssignments MuscleFunctionAssignment[]

  @@index([bodyRegion, isActive])
  @@index([muscleGroupId, isActive])
  @@index([parentId])
}

model Equipment {
  id          String              @id @db.Uuid
  name        String              @unique
  slug        String              @unique
  description String?
  isActive    Boolean             @default(true)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(3)
  exercises   ExerciseEquipment[]
}

model MovementPattern {
  id          String     @id @db.Uuid
  name        String     @unique
  slug        String     @unique
  description String?
  isActive    Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(3)
  exercises   Exercise[]
}

model Exercise {
  id                  String                     @id @db.Uuid
  name                String                     @unique
  slug                String                     @unique
  description         String
  instructions        String
  commonMistakes      String?
  movementPatternId   String                     @db.Uuid
  forceType           ForceType // ENUM (e.g., PUSH, PULL)
  kineticChain        KineticChain // ENUM (e.g., open, closed, mixed)
  isCompound          Boolean
  laterality          Laterality // ENUM (e.g., unilateral, bilateral)
  contractionMode     ContractionMode // ENUM (e.g., dinamyc, isometric, mixed)
  bodyPosition        BodyPosition // ENUM (e.g., standing, sitting)
  skillLevel          SkillLevel // ENUM (e.g., beginner, intermediate, advanced)
  thumbnailUrl        String?
  thumbnailStorageKey String?
  imageAltText        String?
  isActive            Boolean                    @default(true)
  archivedAt          DateTime?                  @db.Timestamptz(3)
  createdAt           DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                   @updatedAt @db.Timestamptz(3)
  movementPattern     MovementPattern            @relation(fields: [movementPatternId], references: [id], onDelete: Restrict)
  muscles             ExerciseMuscle[] // MODEL (Many-to-Many)
  capabilities        ExerciseCapabilityProfile? // MODEL (One-to-One)
  demands             ExerciseDemandProfile? // MODEL (One-to-One)
  equipment           ExerciseEquipment[] // MODEL (Many-to-Many)
  routineExercises    RoutineExercise[] // MODEL (Many-to-Many)
  workoutPerformances ExercisePerformance[]

  @@index([isActive, name])
  @@index([movementPatternId, isActive])
  @@index([skillLevel, isActive])
}

model ExerciseEquipment {
  exerciseId  String    @db.Uuid
  equipmentId String    @db.Uuid
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId, exerciseId])
}

model ExerciseMuscle {
  exerciseId       String     @db.Uuid
  muscleId         String     @db.Uuid
  role             MuscleRole // ENUM (e.g., primary, secondary, stabilizer)
  involvementScore Int
  notes            String?
  createdAt        DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(3)
  exercise         Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle           Muscle     @relation(fields: [muscleId], references: [id], onDelete: Restrict)

  @@id([exerciseId, muscleId])
  @@index([muscleId, role])
  @@index([exerciseId, role])
}

model ExerciseCapabilityProfile {
  exerciseId                    String   @id @db.Uuid
  hypertrophyPotential          Int
  maximalStrengthPotential      Int
  powerDevelopmentPotential     Int
  muscularEndurancePotential    Int
  stabilityDevelopmentPotential Int
  typicalLoadability            Int
  stretchPositionLoading        Int
  shortenedPositionLoading      Int
  editorialNotes                String?
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime @updatedAt @db.Timestamptz(3)
  exercise                      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model ExerciseDemandProfile {
  exerciseId               String   @id @db.Uuid
  technicalDemand          Int
  setupComplexity          Int
  stabilityDemand          Int
  systemicFatiguePotential Int
  localFatiguePotential    Int
  recoveryCostPotential    Int
  gripDemand               Int
  axialLoadingPotential    Int
  editorialNotes           String?
  createdAt                DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @db.Timestamptz(3)
  exercise                 Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}

model Routine {
  id                        String                     @id @db.Uuid
  ownerId                   String                     @db.Uuid
  slug                      String                     @unique
  name                      String
  description               String?
  visibility                RoutineVisibility          @default(PRIVATE)
  createdAt                 DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                   @updatedAt @db.Timestamptz(3)
  owner                     User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  exercises                 RoutineExercise[]
  trainingPrograms          TrainingProgramRoutine[]
  sourceSessions            WorkoutSession[]           @relation("WorkoutSessionSourceRoutine")
  programWorkoutOccurrences ProgramWorkoutOccurrence[] @relation("ProgramWorkoutOccurrenceSourceRoutine")

  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([visibility, updatedAt])
}

model RoutineExercise {
  id           String                @id @db.Uuid
  routineId    String                @db.Uuid
  exerciseSlug String
  order        Int
  sets         Int
  minReps      Int
  maxReps      Int
  targetRir    Int?
  restSeconds  Int?
  tempo        String?
  notes        String?
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  routine      Routine               @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise     Exercise              @relation(fields: [exerciseSlug], references: [slug], onDelete: Restrict)
  performances ExercisePerformance[] @relation("ExercisePerformanceSourceRoutineExercise")

  @@unique([routineId, order])
  @@index([routineId])
  @@index([exerciseSlug])
}

model TrainingProgram {
  id            String                    @id @db.Uuid
  ownerId       String                    @db.Uuid
  slug          String                    @unique
  name          String
  description   String?
  visibility    TrainingProgramVisibility @default(PRIVATE)
  durationWeeks Int
  createdAt     DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(3)

  owner                   User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  routines                TrainingProgramRoutine[]
  adoptedTrainingPrograms AdoptedTrainingProgram[]

  @@index([ownerId, updatedAt])
  @@index([ownerId, name])
  @@index([visibility, updatedAt])
}

model TrainingProgramRoutine {
  id                String  @id @db.Uuid
  trainingProgramId String  @db.Uuid
  routineId         String  @db.Uuid
  weekNumber        Int
  dayNumber         Int
  notes             String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  trainingProgram           TrainingProgram            @relation(fields: [trainingProgramId], references: [id], onDelete: Cascade)
  routine                   Routine                    @relation(fields: [routineId], references: [id], onDelete: Restrict)
  programWorkoutOccurrences ProgramWorkoutOccurrence[] @relation("ProgramWorkoutOccurrenceSourceProgramRoutine")

  @@unique([trainingProgramId, weekNumber, dayNumber])
  @@index([trainingProgramId, weekNumber, dayNumber])
  @@index([routineId])
}

model AdoptedTrainingProgram {
  id                      String                       @id @db.Uuid
  ownerId                 String                       @db.Uuid
  sourceTrainingProgramId String?                      @db.Uuid
  programNameSnapshot     String
  durationWeeksSnapshot   Int
  status                  AdoptedTrainingProgramStatus @default(ACTIVE)
  startedAt               DateTime                     @db.Timestamptz(3)
  completedAt             DateTime?                    @db.Timestamptz(3)
  cancelledAt             DateTime?                    @db.Timestamptz(3)
  createdAt               DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime                     @updatedAt @db.Timestamptz(3)

  owner                 User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceTrainingProgram TrainingProgram?           @relation(fields: [sourceTrainingProgramId], references: [id], onDelete: SetNull)
  workouts              ProgramWorkoutOccurrence[]

  @@index([ownerId, status, updatedAt])
  @@index([sourceTrainingProgramId])
}

model ProgramWorkoutOccurrence {
  id                             String                         @id @db.Uuid
  adoptedTrainingProgramId       String                         @db.Uuid
  sourceTrainingProgramRoutineId String?                        @db.Uuid
  sourceRoutineId                String?                        @db.Uuid
  weekNumber                     Int
  dayNumber                      Int
  routineNameSnapshot            String
  programSlotNotesSnapshot       String?
  status                         ProgramWorkoutOccurrenceStatus @default(PENDING)
  createdAt                      DateTime                       @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                       @updatedAt @db.Timestamptz(3)

  adoptedTrainingProgram       AdoptedTrainingProgram  @relation(fields: [adoptedTrainingProgramId], references: [id], onDelete: Restrict)
  sourceTrainingProgramRoutine TrainingProgramRoutine? @relation("ProgramWorkoutOccurrenceSourceProgramRoutine", fields: [sourceTrainingProgramRoutineId], references: [id], onDelete: SetNull)
  sourceRoutine                Routine?                @relation("ProgramWorkoutOccurrenceSourceRoutine", fields: [sourceRoutineId], references: [id], onDelete: SetNull)
  sessionAttempts              WorkoutSession[]

  @@unique([adoptedTrainingProgramId, weekNumber, dayNumber])
  @@index([adoptedTrainingProgramId, weekNumber, dayNumber])
  @@index([adoptedTrainingProgramId, status, weekNumber, dayNumber])
  @@index([sourceTrainingProgramRoutineId])
  @@index([sourceRoutineId])
}

model WorkoutSession {
  id                         String               @id @db.Uuid
  ownerId                    String               @db.Uuid
  sourceRoutineId            String?              @db.Uuid
  sourceRoutineNameSnapshot  String?
  programWorkoutOccurrenceId String?              @db.Uuid
  status                     WorkoutSessionStatus @default(IN_PROGRESS)
  timezone                   String
  startedAt                  DateTime             @db.Timestamptz(3)
  completedAt                DateTime?            @db.Timestamptz(3)
  cancelledAt                DateTime?            @db.Timestamptz(3)
  createdAt                  DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt                  DateTime             @updatedAt @db.Timestamptz(3)
  version                    Int                  @default(0)

  owner                    User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  sourceRoutine            Routine?                  @relation("WorkoutSessionSourceRoutine", fields: [sourceRoutineId], references: [id], onDelete: SetNull)
  programWorkoutOccurrence ProgramWorkoutOccurrence? @relation(fields: [programWorkoutOccurrenceId], references: [id], onDelete: SetNull)
  performances             ExercisePerformance[]

  @@index([ownerId, startedAt])
  @@index([ownerId, status, startedAt])
  @@index([sourceRoutineId])
  @@index([programWorkoutOccurrenceId])
}

model ExercisePerformance {
  id                      String   @id @db.Uuid
  workoutSessionId        String   @db.Uuid
  exerciseId              String   @db.Uuid
  sourceRoutineExerciseId String?  @db.Uuid
  order                   Int
  exerciseNameSnapshot    String
  targetSetCount          Int?
  targetMinReps           Int?
  targetMaxReps           Int?
  targetRir               Int?
  targetRestSeconds       Int?
  targetTempo             String?
  prescriptionNotes       String?
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @updatedAt @db.Timestamptz(3)

  workoutSession        WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise              Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sourceRoutineExercise RoutineExercise? @relation("ExercisePerformanceSourceRoutineExercise", fields: [sourceRoutineExerciseId], references: [id], onDelete: SetNull)
  completedSets         CompletedSet[]

  @@unique([workoutSessionId, order])
  @@index([workoutSessionId])
  @@index([exerciseId, createdAt])
  @@index([sourceRoutineExerciseId])
}

model CompletedSet {
  id                    String   @id @db.Uuid
  exercisePerformanceId String   @db.Uuid
  order                 Int
  repetitions           Int
  loadKg                Decimal  @db.Decimal(7, 2)
  loadUnit              LoadUnit
  rir                   Int?
  isWarmup              Boolean  @default(false)
  completedAt           DateTime @db.Timestamptz(3)
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)

  exercisePerformance ExercisePerformance @relation(fields: [exercisePerformanceId], references: [id], onDelete: Cascade)

  @@unique([exercisePerformanceId, order])
  @@index([exercisePerformanceId])
  @@index([exercisePerformanceId, completedAt])
}

// ###########################################################################################################################
// ########################### ADDING MUSCLE FUNCTIONS ######################################################################
// ###########################################################################################################################
enum MuscleFunctionRole {
  PRIMARY
  SECONDARY
}

model MuscleFunction {
  id          String   @id @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  assignments MuscleFunctionAssignment[]
}

model MuscleFunctionAssignment {
  muscleId          String             @db.Uuid
  functionId        String             @db.Uuid
  role              MuscleFunctionRole
  contributionScore Int?
  notes             String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  muscle         Muscle         @relation(fields: [muscleId], references: [id], onDelete: Cascade)
  muscleFunction MuscleFunction @relation(fields: [functionId], references: [id], onDelete: Restrict)

  @@id([muscleId, functionId])
  @@index([functionId, role])
  @@index([muscleId, role])
}
