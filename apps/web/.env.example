NEXT_PUBLIC_API_URL=http://localhost:3000
API_PROXY_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Production-only Sentry configuration. Configure these only in Vercel's
# Production environment; previews and local builds remain unmonitored.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=kinetiq-web

# Optional real API smoke test configuration.
WEB_SMOKE_BASE_URL=http://localhost:3001
WEB_SMOKE_EMAIL=
WEB_SMOKE_PASSWORD=
