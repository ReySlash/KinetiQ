NODE_ENV=production
PORT=3000
WEB_ORIGIN=https://kinetiq.reyslash.com
DATABASE_URL=postgresql://production-role:replace-me@your-neon-host/neondb?sslmode=require
BETTER_AUTH_URL=https://kinetiq.reyslash.com
BETTER_AUTH_SECRET=replace-with-high-entropy-secret-at-least-32-characters
RESEND_API_KEY=re_replace-me
RESEND_FROM_EMAIL=KinetiQ <noreply@kinetiq.reyslash.com>
COMMIT_SHA=replace-with-reviewed-git-sha
SENTRY_DSN=https://replace-with-api-project-dsn
# SENTRY_AUTH_TOKEN and SENTRY_ORG are build-only inputs. Pass the token through
# the Docker BuildKit secret; do not add it to this runtime environment file.
NEXT_PUBLIC_API_URL=https://kinetiq.reyslash.com
NEXT_PUBLIC_SITE_URL=https://kinetiq.reyslash.com
